{
  "name": "CxExam_automatic_answering",
  "version": "1.0.0",
  "description": "CxExam_automatic_answering",
  "main": "ui.js",
  "scripts": {
    "start": "chcp 65001 >nul && electron .",
    "dev": "node main.js",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "dist": "electron-builder --publish=never"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  },
  "keywords": [
    "electron",
    "ui",
    "authentication",
    "mac",
    "address",
    "network",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.cxexam.automatic-answering",
    "productName": "CxExam自动答题1.0.0",
    "directories": {
      "output": "dist-1.0.0"
    },
    "files": [
      "ui.js",
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "logger.js",
      "server.js",
      "winmm.dll",
      "model/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
