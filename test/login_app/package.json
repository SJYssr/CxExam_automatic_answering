{
  "name": "cxexam-electron",
  "version": "1.0.4",
  "private": true,
  "main": "electron-main.js",
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cxexam.app",
    "productName": "CxExam-AUTO",
    "directories": {
      "output": "dist-1.0.4"
    },
    "files": [
      "electron-main.js",
      "index.html",
      "main.js",
      "models/**/*",
      "package.json",
      "preload.js",
      "renderer.js",
      "winmm.dll",
      "!models/**/*.test.js",
      "!models/**/*.spec.js"
    ],
    "asar": true,
    "asarUnpack": [],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": null,
      "uninstallerIcon": null,
      "installerHeaderIcon": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CxExam-AUTO",
      "include": null,
      "script": null,
      "perMachine": true,
      "runAfterFinish": false
    }
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  }
}

