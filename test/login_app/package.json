{
  "name": "cxexam-electron",
  "version": "1.0.12",
  "private": true,
  "main": "electron-main.js",
  "dependencies": {
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "bytenode": "^1.5.7",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-bytenode-webpack-plugin": "^1.1.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "appId": "com.cxexam.app",
    "productName": "CxExam-AUTO",
    "directories": {
      "output": "dist-1.0.12"
    },
    "files": [
      "electron-main.js",
      "index.html",
      "main.js",
      "tokenChannel.js",
      "apiKeyChannel.js",
      "scriptControlChannel.js",
      "models/**/*",
      "package.json",
      "preload.js",
      "renderer.js",
      "winmm.dll",
      "icon/**/*",
      "!models/**/*.test.js",
      "!models/**/*.spec.js",
      "!**/*.md",
      "!**/*.map",
      "!**/*.log",
      "!**/README*",
      "!**/LICENSE*",
      "!**/.git*",
      "!**/node_modules/.cache/**/*"
    ],
    "asar": true,
    "asarUnpack": [],
    "compression": "maximum",
    "win": {
      "icon": "icon/favicon1.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "icon/favicon2.ico",
      "uninstallerIcon": "icon/favicon2.ico",
      "installerHeaderIcon": "icon/favicon2.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CxExam-AUTO",
      "include": null,
      "script": null,
      "perMachine": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  }
}
